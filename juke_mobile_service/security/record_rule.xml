<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mobile_service_tech" model="ir.rule">
            <field name="name">own doc mobile service</field>
            <field name="model_id" ref="model_mobile_service_service_request"/>
            <field name="domain_force">[('technician_id', 'in', [False, user.id])]</field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="groups" eval="[(4, ref('juke_mobile_service.group_mobile_service_technician'))]"/>
        </record>
        <record id="mobile_service_manager" model="ir.rule">
            <field name="name">all mobile service</field>
            <field name="model_id" ref="model_mobile_service_service_request"/>
            <field name="domain_force">[]</field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('juke_mobile_service.group_mobile_service_manager'))]"/>
        </record>
    </data>
</odoo>