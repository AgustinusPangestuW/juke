<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="mobile_service_model_tree">
            <field name="name">mobile_service.model.tree</field>
            <field name="model">mobile_service.model</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="brand_id" />
                </list>
            </field>
        </record>
        
        <!-- Form View -->
        <record model="ir.ui.view" id="mobile_service_model_form">
            <field name="name">mobile_service.model.form</field>
            <field name="model">mobile_service.model</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="brand_id" />
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mobile_service_model_action">
            <field name="name">Models</field>
            <field name="res_model">mobile_service.model</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>