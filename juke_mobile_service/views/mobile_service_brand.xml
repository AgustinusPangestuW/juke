<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="mobile_service_brand_view_tree" model="ir.ui.view">
            <field name="name">mobile_service_brand_view_tree</field>
            <field name="model">mobile_service.brand</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="name" />
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="mobile_service_brand_view_form" model="ir.ui.view">
            <field name="name">mobile_service_brand_view_form</field>
            <field name="model">mobile_service.brand</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mobile_service_brand_action">
            <field name="name">Brand</field>
            <field name="res_model">mobile_service.brand</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="mobile_service_brand_view_tree"/>
        </record>
    </data>
</odoo>