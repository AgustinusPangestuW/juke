<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="mobile_service_complaint_type_tree">
            <field name="name">mobile_service.complaint_type.tree</field>
            <field name="model">mobile_service.complaint_type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>
        
        <!-- Form View -->
        <record model="ir.ui.view" id="mobile_service_complaint_type_form">
            <field name="name">mobile_service.complaint_type.form</field>
            <field name="model">mobile_service.complaint_type</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mobile_service_complaint_type_action">
            <field name="name">Complaint Types</field>
            <field name="res_model">mobile_service.complaint_type</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>