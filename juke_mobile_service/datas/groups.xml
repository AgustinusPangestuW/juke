<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_mobile_service" model="ir.module.category">
            <field name="name">Mobile Service</field>
            <field name="parent_id" ref=""/>
            <field name="sequence" eval="100"/>
        </record>
        <record model="res.groups" id="group_mobile_service_technician">
            <field name="name">Technician</field>
            <field name="category_id" ref="group_mobile_service"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record model="res.groups" id="group_mobile_service_manager">
            <field name="name">Manager</field>
            <field name="category_id" ref="group_mobile_service"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_mobile_service_technician'))]"/>
        </record>
    </data>
</odoo>